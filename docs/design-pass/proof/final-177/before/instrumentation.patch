diff --git a/Cadence/CadenceApp.swift b/Cadence/CadenceApp.swift
index e87307a..798689b 100644
--- a/Cadence/CadenceApp.swift
+++ b/Cadence/CadenceApp.swift
@@ -29,7 +29,34 @@ final class AppBootstrap: ObservableObject {
     @Published private(set) var errorMessage: String?
     @Published private(set) var isTemporary = false
 
-    init() { loadPersistentStore() }
+    init() {
+#if DEBUG
+        if ProcessInfo.processInfo.arguments.contains("--visual-proof") {
+            loadVisualProofStore()
+            return
+        }
+#endif
+        loadPersistentStore()
+    }
+
+#if DEBUG
+    /// Disposable fixture used only by the unmerged baseline-proof target.
+    private func loadVisualProofStore() {
+        do {
+            let loaded = try makeContainer(
+                migrationPlan: CadencePre72MigrationPlan.self,
+                isStoredInMemoryOnly: true
+            )
+            try prepare(loaded)
+            try VisualProofSeed.install(in: loaded.mainContext)
+            isTemporary = true
+            container = loaded
+            errorMessage = nil
+        } catch {
+            errorMessage = "Couldn't prepare the baseline fixture: \(error.localizedDescription)"
+        }
+    }
+#endif
 
     func loadPersistentStore() {
         container = nil
