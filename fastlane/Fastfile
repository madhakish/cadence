require_relative "certs_repo"

default_platform(:ios)

# Fully headless signing and TestFlight promotion. CI deliberately separates
# build_beta from upload_beta: the signed IPA is sealed as a workflow artifact,
# then every publisher consumes those exact bytes. No upload lane may compile.

APP_ID = ENV["APP_IDENTIFIER"] || "com.madhakish.Cadence"
# The Live Activity ships in an embedded widget extension with its own App ID,
# which needs its own distribution profile or the archive will not sign.
WIDGET_ID = "#{APP_ID}.Widgets"
# The embedded watch app is a third App ID with its own distribution profile.
WATCH_ID = "#{APP_ID}.watchkitapp"
# The certs repo's protected default branch. Read-only runs read it; changes
# land on it only by pull request (see land_provisioning).
CERTS_BRANCH = "main"
ARTIFACT_DIR = File.expand_path(ENV["ARTIFACT_DIR"] || "../dist", __dir__)
ARTIFACT_NAME = "Cadence-store.ipa"

# A provisioning run's match wrote to `branch`. Land it on CERTS_BRANCH by pull
# request and prove every profile arrived: match itself only logs a failed
# push, which once left a build signed with a profile the repo never stored.
def land_provisioning(certs, branch)
  if certs.ahead?(branch, base: CERTS_BRANCH)
    url = certs.merge_by_pull_request(
      branch, base: CERTS_BRANCH,
      title: "chore(match): store signing material from CI run #{ENV['GITHUB_RUN_ID'] || branch}",
      body: "fastlane match created signing material during a provisioning run " \
            "(MATCH_READONLY=false). Encrypted with MATCH_PASSWORD; generated by CI."
    )
    UI.success("Signing material landed on #{CERTS_BRANCH} via #{url}")
  end
  certs.delete_branch(branch)
  stored = certs.paths(CERTS_BRANCH)
  missing = [APP_ID, WIDGET_ID, WATCH_ID].reject { |id| stored.include?("profiles/appstore/AppStore_#{id}.mobileprovision") }
  return if missing.empty?

  UI.user_error!("The certs repo still has no App Store profile for #{missing.join(', ')} after provisioning")
rescue CertsRepo::Error => e
  UI.user_error!("Provisioning could not land in the certs repo (#{e.message}). The new signing material " \
                 "is on branch #{branch}: merge it into #{CERTS_BRANCH} by pull request, or give the certs " \
                 "token Pull requests: Read and write. Read-only runs fail until it lands.")
end

def cadence_api_key
  app_store_connect_api_key(
    key_id: ENV["ASC_KEY_ID"],
    issuer_id: ENV["ASC_ISSUER_ID"],
    key_content: ENV["ASC_KEY_CONTENT"], # base64 of the .p8 (robust for multiline secrets)
    is_key_content_base64: true
  )
end

platform :ios do
  desc "Build and sign the immutable Release IPA without uploading it"
  lane :build_beta do
    # Read the first-run override before setup_ci: setup_ci sets
    # MATCH_READONLY=true for the rest of the lane ("Enabling match readonly
    # mode"), so reading it afterwards made the documented MATCH_READONLY=false
    # provisioning run (docs/TESTFLIGHT.md) impossible.
    match_readonly = ENV["MATCH_READONLY"] != "false"

    # Create + unlock a temporary CI keychain so `match` imports the distribution
    # cert somewhere `codesign` can use non-interactively. Without this, match
    # lands the cert in the locked login keychain and codesign can hang waiting
    # for a GUI prompt on the headless runner.
    setup_ci
    api_key = cadence_api_key

    # Generate Cadence.xcodeproj from the XcodeGen spec (gitignored in repo).
    sh("cd .. && xcodegen generate")

    # The App IDs and App Store Connect record are created once by hand; see
    # docs/TESTFLIGHT.md. Routine CI only reads signing material. A
    # provisioning run never writes to the protected certs branch: match gets
    # a fresh branch that lands by pull request.
    certs = match_readonly ? nil : CertsRepo.new(url: ENV["MATCH_GIT_URL"],
                                                 authorization: ENV["MATCH_GIT_BASIC_AUTHORIZATION"])
    provision_branch = certs && "match/provision-#{ENV['GITHUB_RUN_ID'] || Time.now.utc.strftime('%Y%m%d%H%M%S')}"
    certs&.start_branch(provision_branch, base: CERTS_BRANCH)
    match(type: "appstore", app_identifier: [APP_ID, WIDGET_ID, WATCH_ID], api_key: api_key,
          readonly: match_readonly, git_branch: provision_branch || CERTS_BRANCH)
    land_provisioning(certs, provision_branch) if certs

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Cadence.xcodeproj",
      targets: ["Cadence"],
      team_id: ENV["DEVELOPER_TEAM_ID"],
      code_sign_identity: "Apple Distribution",
      profile_name: ENV["sigh_#{APP_ID}_appstore_profile-name"]
    )
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Cadence.xcodeproj",
      targets: ["CadenceWidgets"],
      team_id: ENV["DEVELOPER_TEAM_ID"],
      code_sign_identity: "Apple Distribution",
      profile_name: ENV["sigh_#{WIDGET_ID}_appstore_profile-name"]
    )
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Cadence.xcodeproj",
      targets: ["CadenceWatch"],
      team_id: ENV["DEVELOPER_TEAM_ID"],
      code_sign_identity: "Apple Distribution",
      profile_name: ENV["sigh_#{WATCH_ID}_appstore_profile-name"]
    )

    # Version + build number are build-setting overrides. The version comes
    # from the same commit analyzer that gates this job; the build number is
    # allocated once from TestFlight before the immutable IPA is created.
    next_build = latest_testflight_build_number(
      api_key: api_key, app_identifier: APP_ID, initial_build_number: 0
    ) + 1
    app_version = ENV["APP_VERSION"].to_s.strip
    UI.user_error!("APP_VERSION is required") if app_version.empty?

    build_app(
      scheme: "Cadence",
      project: "Cadence.xcodeproj",
      configuration: "Release",
      export_method: "app-store",
      output_directory: ARTIFACT_DIR,
      output_name: ARTIFACT_NAME,
      export_options: {
        provisioningProfiles: {
          APP_ID => ENV["sigh_#{APP_ID}_appstore_profile-name"],
          WIDGET_ID => ENV["sigh_#{WIDGET_ID}_appstore_profile-name"],
          WATCH_ID => ENV["sigh_#{WATCH_ID}_appstore_profile-name"]
        }
      },
      xcargs: "-allowProvisioningUpdates CURRENT_PROJECT_VERSION=#{next_build} MARKETING_VERSION=#{app_version}"
    )
  end

  desc "Upload an already-built signed IPA to TestFlight without rebuilding"
  lane :upload_beta do
    ipa_path = File.expand_path(ENV["IPA_PATH"] || File.join(ARTIFACT_DIR, ARTIFACT_NAME))
    UI.user_error!("Signed IPA not found at #{ipa_path}") unless File.file?(ipa_path)

    upload_to_testflight(
      api_key: cadence_api_key,
      app_identifier: APP_ID,
      ipa: ipa_path,
      skip_waiting_for_build_processing: true
    )
  end

  # Retain the one-command local/recovery entrypoint, but keep the phase split
  # visible so CI can persist and promote the bytes between them.
  desc "Build, sign, and upload in one local invocation"
  lane :beta do
    build_beta
    upload_beta
  end
end
